# Base URL for the SpendWise NestJS API
# - iOS Simulator: http://localhost:4000/api/v1 (or leave unset for automatic resolution)
# - Android Emulator: Automatically resolves to http://10.0.2.2:4000/api/v1
# - Physical device (Expo Go): Automatically resolves to host LAN IP
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_NAME=SpendWise
